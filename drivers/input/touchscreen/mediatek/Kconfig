	  Say Y here if you have GT1151 touch panel.

	  If unsure, say N.

	  To compile this dirver as a module, choose M here: the
	  module will be called.

source "drivers/input/touchscreen/mediatek/GT1151/Kconfig"

config TOUCHSCREEN_MTK_NT36xxx
	bool "NT36xxx for Mediatek package"
	default n
	help
	  Say Y here if you have NT36xxx touch panel.

	  If unsure, say N.

	  To compile this dirver as a module, choose M here: the
	  module will be called.

source "drivers/input/touchscreen/mediatek/NT36xxx/Kconfig"




config TOUCHSCREEN_HIMAX_CHIPSET
        bool "Himax touchpane HIMAX_CHIPSET for mtk platform"
	depends on I2C
        default n
        help
          Say Y here if you have HIMAX touch panel.

          If unsure, say N.

          To compile this dirver as a module, choose M here: the
          module will be called.


#source "drivers/input/touchscreen/mediatek/hxchipset/Kconfig"



config TOUCHSCREEN_MTK_ILI988H
        bool "ILI988H chipset for mtk platform"
        default n
        help
          Say Y here if you have HIMAX touch panel.

          If unsure, say N.

          To compile this dirver as a module, choose M here: the
          module will be called.


config TOUCHSCREEN_HIMAX_CHIPSET_I2C
	bool "Himax touchpanel CHIPSET I2C"
	depends on I2C
	help
	  Say Y here if you have a Himax I2C CHIPSET touchscreen.
	  HIMAX controllers are multi touch controllers which can
	  report 10 touches at a time.

          If unsure, say N.
#source "drivers/input/touchscreen/mediatek/hxchipset_i2c/Kconfig"

source "drivers/input/touchscreen/mediatek/hxchipset/Kconfig"

